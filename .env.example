# QuantumReach Agency OS — environment template
# Copy to .env on Jarvis: cp .env.example .env

# --- Founder identity ---
FOUNDER_NAME=Yagya Chauhan
FOUNDER_EMAIL_PRIMARY=connect@quantumreach.tech
FOUNDER_EMAIL_PERSONAL=yagya@quantumreach.tech
AGENCY_NAME=QuantumReach
AGENCY_DOMAIN=quantumreach.tech
TIMEZONE=Asia/Kolkata

# --- Telegram (required) ---
# Create the bot via @BotFather. Get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_USER_IDS=

# --- Storage ---
SQLITE_PATH=/app/data/db/agency.sqlite
DATA_DIR=/app/data

# --- Scheduling toggles (1 = enabled) ---
ENABLE_SCHEDULER=1
ENABLE_TELEGRAM_BOT=1

# --- Email (DRAFT MODE ONLY — never auto-send) ---
EMAIL_SEND_ENABLED=0
EMAIL_FROM_NAME=Yagya — QuantumReach
EMAIL_REPLY_TO=connect@quantumreach.tech

# --- Optional AI for proposal copy polish (leave blank to use templates only) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Lead research providers (Jarvis only; never commit real keys) ---
SERPAPI_API_KEY=
APIFY_API_TOKEN=
MAX_RESEARCH_QUERIES_PER_DAY=80
RESEARCH_DRY_RUN=0

# --- Pricing (INR) ---
PKG_STARTER_ONE_TIME=14999
PKG_STARTER_MONTHLY=3499
PKG_PRO_ONE_TIME=34999
PKG_PRO_MONTHLY=5999
PKG_ENTERPRISE_ONE_TIME=79999
PKG_ENTERPRISE_MONTHLY=9999

# --- Pricing (USD, Dubai/foreign) ---
USD_LAUNCH_MIN=499
USD_LAUNCH_MAX=799
USD_GROWTH_MIN=1200
USD_GROWTH_MAX=2500
USD_INFRA_MIN=3000
USD_INFRA_MAX=7500

# --- Logging ---
LOG_LEVEL=INFO
